{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A video project containing scenes and interactions",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["draft", "processing", "completed"] },
        "thumbnail": { "type": "string" }
      },
      "required": ["title", "ownerId", "createdAt", "updatedAt"]
    },
    "Scene": {
      "title": "Scene",
      "description": "A single video segment within a project",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "videoPrompt": { "type": "string" },
        "voicePrompt": { "type": "string" },
        "voiceId": { "type": "string" },
        "duration": { "type": "number" },
        "order": { "type": "number" },
        "backgroundMusic": { "type": "string" },
        "subtitles": { "type": "string" },
        "style": { "type": "string" },
        "videoUrl": { "type": "string" },
        "audioUrl": { "type": "string" }
      },
      "required": ["projectId", "title", "order"]
    },
    "Interaction": {
      "title": "Interaction",
      "description": "An interactive element overlaying the video",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "type": { "type": "string", "enum": ["MCQ", "DRAG_DROP", "FILL_BLANKS", "TRUE_FALSE", "POLL"] },
        "question": { "type": "string" },
        "options": { "type": "array" },
        "correctAnswer": { "type": "string" },
        "timestamp": { "type": "number" },
        "feedback": { "type": "string" }
      },
      "required": ["projectId", "type", "question", "timestamp"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Main project document"
    },
    "/projects/{projectId}/scenes/{sceneId}": {
      "schema": "Scene",
      "description": "Scenes within the project"
    },
    "/projects/{projectId}/interactions/{interactionId}": {
      "schema": "Interaction",
      "description": "Interactions within the project"
    }
  }
}
